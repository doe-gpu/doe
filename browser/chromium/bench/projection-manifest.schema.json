{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fawn.local/schemas/browser/browser_projection_manifest.schema.json",
  "title": "BrowserProjectionManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceWorkloadsPath",
    "sourceWorkloadsSha256",
    "rulesPath",
    "rulesSha256",
    "projectionContractHash",
    "sourceWorkloadCount",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 4
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceWorkloadsPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceWorkloadsSha256": {
      "$ref": "#/$defs/hashHex"
    },
    "rulesPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "rulesSha256": {
      "$ref": "#/$defs/hashHex"
    },
    "projectionContractHash": {
      "$ref": "#/$defs/hashHex"
    },
    "sourceWorkloadCount": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hashHex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "row": {
      "type": "object",
      "required": [
        "sourceWorkloadId",
        "sourceWorkloadName",
        "domain",
        "projectionClass",
        "layerTarget",
        "scenarioTemplate",
        "comparabilityExpectation",
        "requiredStatus",
        "claimScope",
        "claimLanguage",
        "projectionNote",
        "browserWorkload"
      ],
      "properties": {
        "sourceWorkloadId": {
          "type": "string",
          "minLength": 1
        },
        "sourceWorkloadName": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "projectionClass": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "non_projectable"
          ]
        },
        "layerTarget": {
          "type": "string",
          "enum": [
            "l1_browser_api",
            "l0_only"
          ]
        },
        "scenarioTemplate": {
          "type": "string",
          "minLength": 1
        },
        "comparabilityExpectation": {
          "type": "string",
          "enum": [
            "strict",
            "component",
            "none"
          ]
        },
        "requiredStatus": {
          "type": "string",
          "enum": [
            "ok",
            "not_applicable"
          ]
        },
        "claimScope": {
          "type": "string",
          "enum": [
            "l1_strict_candidate",
            "l1_component_only",
            "l0_only_no_claim"
          ]
        },
        "claimLanguage": {
          "type": "string",
          "minLength": 1
        },
        "projectionNote": {
          "type": "string",
          "minLength": 1
        },
        "browserWorkload": {
          "$ref": "#/$defs/browserWorkload"
        }
      },
      "additionalProperties": false
    },
    "browserWorkload": {
      "type": "object",
      "required": [
        "sourceComparable",
        "sourceClaimEligible"
      ],
      "properties": {
        "sourceComparable": {
          "type": "boolean"
        },
        "sourceClaimEligible": {
          "type": "boolean"
        },
        "benchmarkClass": {
          "type": "string",
          "minLength": 1
        },
        "uploadBytes": {
          "type": "integer",
          "minimum": 1
        },
        "computeProjection": {
          "type": "string",
          "enum": [
            "generic_empty_dispatch_component",
            "source_kernel_dispatch_v1"
          ]
        },
        "bindGroupLayoutMode": {
          "type": "string",
          "enum": [
            "explicit_min_binding_size_v1"
          ]
        },
        "readbackBindingPolicy": {
          "type": "string",
          "enum": [
            "first_writable_storage_binding_v1"
          ]
        },
        "commandsPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "commandsSha256": {
          "$ref": "#/$defs/hashHex"
        },
        "kernelPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "kernelSha256": {
          "$ref": "#/$defs/hashHex"
        },
        "dispatchX": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchY": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchZ": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchRepeat": {
          "type": "integer",
          "minimum": 1
        },
        "warmupDispatchCount": {
          "type": "integer",
          "minimum": 0
        },
        "storageBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "group",
              "binding",
              "bufferSize",
              "minBindingSize",
              "bufferType",
              "bufferBindingType"
            ],
            "properties": {
              "group": {
                "type": "integer",
                "minimum": 0
              },
              "binding": {
                "type": "integer",
                "minimum": 0
              },
              "bufferSize": {
                "type": "integer",
                "minimum": 1
              },
              "minBindingSize": {
                "type": "integer",
                "minimum": 1
              },
              "bufferType": {
                "type": "string",
                "minLength": 1
              },
              "bufferBindingType": {
                "type": "string",
                "enum": [
                  "storage",
                  "read-only-storage"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "textureWidth": {
          "type": "integer",
          "minimum": 1
        },
        "textureHeight": {
          "type": "integer",
          "minimum": 1
        },
        "mipLevelCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
