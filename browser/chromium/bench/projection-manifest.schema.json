{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fawn.local/schemas/browser/browser_projection_manifest.schema.json",
  "title": "BrowserProjectionManifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceWorkloadsPath",
    "sourceWorkloadsSha256",
    "rulesPath",
    "rulesSha256",
    "projectionContractHash",
    "sourceWorkloadCount",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 7
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceWorkloadsPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sourceWorkloadsSha256": {
      "$ref": "#/$defs/hashHex"
    },
    "rulesPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "rulesSha256": {
      "$ref": "#/$defs/hashHex"
    },
    "projectionContractHash": {
      "$ref": "#/$defs/hashHex"
    },
    "sourceWorkloadCount": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hashHex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rgba8": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "sourceOutputOracle": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "initialization",
        "bindingGroup",
        "binding",
        "dispatchCount",
        "expectedSha256",
        "referenceId"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "sha256_exact_v1" },
        "initialization": { "type": "string", "const": "zero_fill_v1" },
        "bindingGroup": { "type": "integer", "minimum": 0 },
        "binding": { "type": "integer", "minimum": 0 },
        "dispatchCount": { "type": "integer", "minimum": 1 },
        "expectedSha256": { "$ref": "#/$defs/hashHex" },
        "referenceId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "renderOutputOracle": {
      "type": "object",
      "required": [
        "schemaVersion",
        "kind",
        "width",
        "height",
        "bytesPerRow",
        "rect",
        "insideRgba",
        "outsideRgba",
        "expectedSha256",
        "referenceId"
      ],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "kind": { "type": "string", "const": "rgba8_exact_rect_v1" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "bytesPerRow": { "type": "integer", "minimum": 256, "multipleOf": 256 },
        "rect": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "insideRgba": { "$ref": "#/$defs/rgba8" },
        "outsideRgba": { "$ref": "#/$defs/rgba8" },
        "expectedSha256": { "$ref": "#/$defs/hashHex" },
        "referenceId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": [
        "sourceWorkloadId",
        "sourceWorkloadName",
        "domain",
        "projectionClass",
        "layerTarget",
        "scenarioTemplate",
        "comparabilityExpectation",
        "requiredStatus",
        "claimScope",
        "claimLanguage",
        "projectionNote",
        "browserWorkload"
      ],
      "properties": {
        "sourceWorkloadId": {
          "type": "string",
          "minLength": 1
        },
        "sourceWorkloadName": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "projectionClass": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "non_projectable"
          ]
        },
        "layerTarget": {
          "type": "string",
          "enum": [
            "l1_browser_api",
            "l0_only"
          ]
        },
        "scenarioTemplate": {
          "type": "string",
          "minLength": 1
        },
        "comparabilityExpectation": {
          "type": "string",
          "enum": [
            "strict",
            "component",
            "none"
          ]
        },
        "requiredStatus": {
          "type": "string",
          "enum": [
            "ok",
            "not_applicable"
          ]
        },
        "claimScope": {
          "type": "string",
          "enum": [
            "l1_strict_candidate",
            "l1_component_only",
            "l0_only_no_claim"
          ]
        },
        "claimLanguage": {
          "type": "string",
          "minLength": 1
        },
        "projectionNote": {
          "type": "string",
          "minLength": 1
        },
        "browserWorkload": {
          "$ref": "#/$defs/browserWorkload"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "comparabilityExpectation": {
                "const": "strict"
              }
            },
            "required": [
              "comparabilityExpectation"
            ]
          },
          "then": {
            "properties": {
              "browserWorkload": {
                "properties": {
                  "sourceComparable": {
                    "const": true
                  },
                  "sourceClaimEligible": {
                    "const": true
                  },
                  "benchmarkClass": {
                    "const": "comparable"
                  }
                },
                "required": [
                  "benchmarkClass"
                ]
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "comparabilityExpectation": {
                  "const": "strict"
                }
              },
              "required": [
                "comparabilityExpectation"
              ]
            }
          },
          "then": {
            "properties": {
              "browserWorkload": {
                "properties": {
                  "benchmarkClass": {
                    "not": {
                      "const": "comparable"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "domain": { "const": "render" }
            },
            "required": ["domain"]
          },
          "then": {
            "properties": {
              "browserWorkload": {
                "required": ["renderOutputOracle"]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "browserWorkload": {
      "type": "object",
      "required": [
        "sourceComparable",
        "sourceClaimEligible"
      ],
      "properties": {
        "sourceComparable": {
          "type": "boolean"
        },
        "sourceClaimEligible": {
          "type": "boolean"
        },
        "benchmarkClass": {
          "type": "string",
          "enum": [
            "comparable",
            "directional"
          ]
        },
        "uploadBytes": {
          "type": "integer",
          "minimum": 1
        },
        "computeProjection": {
          "type": "string",
          "enum": [
            "generic_direct_dispatch_component",
            "generic_empty_dispatch_component",
            "generic_indirect_dispatch_component",
            "source_kernel_dispatch_v1",
            "source_kernel_dispatch_oracle_v2"
          ]
        },
        "directDispatchArgs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 1
              },
              "y": {
                "type": "integer",
                "minimum": 1
              },
              "z": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "indirectDispatchArgs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 1
              },
              "y": {
                "type": "integer",
                "minimum": 1
              },
              "z": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "bindGroupLayoutMode": {
          "type": "string",
          "enum": [
            "explicit_min_binding_size_v1"
          ]
        },
        "readbackBindingPolicy": {
          "type": "string",
          "enum": [
            "first_writable_storage_binding_v1"
          ]
        },
        "commandsPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "commandsSha256": {
          "$ref": "#/$defs/hashHex"
        },
        "kernelPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "kernelSha256": {
          "$ref": "#/$defs/hashHex"
        },
        "dispatchX": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchY": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchZ": {
          "type": "integer",
          "minimum": 1
        },
        "dispatchRepeat": {
          "type": "integer",
          "minimum": 1
        },
        "warmupDispatchCount": {
          "type": "integer",
          "minimum": 0
        },
        "storageBindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "group",
              "binding",
              "bufferSize",
              "minBindingSize",
              "bufferType",
              "bufferBindingType"
            ],
            "properties": {
              "group": {
                "type": "integer",
                "minimum": 0
              },
              "binding": {
                "type": "integer",
                "minimum": 0
              },
              "bufferSize": {
                "type": "integer",
                "minimum": 1
              },
              "minBindingSize": {
                "type": "integer",
                "minimum": 1
              },
              "bufferType": {
                "type": "string",
                "minLength": 1
              },
              "bufferBindingType": {
                "type": "string",
                "enum": [
                  "storage",
                  "read-only-storage"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "outputOracle": {
          "$ref": "#/$defs/sourceOutputOracle"
        },
        "renderOutputOracle": {
          "$ref": "#/$defs/renderOutputOracle"
        },
        "textureWidth": {
          "type": "integer",
          "minimum": 1
        },
        "textureHeight": {
          "type": "integer",
          "minimum": 1
        },
        "mipLevelCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "computeProjection": { "const": "source_kernel_dispatch_oracle_v2" }
            },
            "required": ["computeProjection"]
          },
          "then": {
            "required": ["outputOracle"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
