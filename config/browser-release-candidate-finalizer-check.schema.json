{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fawn://config/browser-release-candidate-finalizer-check.schema.json",
  "title": "Browser release candidate finalizer check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "status",
    "finalizerStatus",
    "finalizerReportPath",
    "finalizerReportSha256",
    "verifyFilesRootProvided",
    "requirePass",
    "failures"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "browser_release_candidate_finalizer_check" },
    "status": { "enum": ["pass", "fail"] },
    "finalizerStatus": { "enum": ["pass", "fail", "unknown"] },
    "finalizerReportPath": { "type": "string", "minLength": 1 },
    "finalizerReportSha256": { "$ref": "#/$defs/Hash" },
    "verifyFilesRootProvided": { "type": "boolean" },
    "requirePass": { "type": "boolean" },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseArtifactBundle", "runtimeFrontierBundle"],
      "properties": {
        "releaseArtifactBundle": {
          "allOf": [
            { "$ref": "#/$defs/Artifact" },
            {
              "properties": {
                "kind": { "const": "browser_release_artifact_bundle" }
              }
            }
          ]
        },
        "runtimeFrontierBundle": {
          "allOf": [
            { "$ref": "#/$defs/Artifact" },
            {
              "properties": {
                "kind": { "const": "browser_runtime_frontier_bundle" }
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageInputs", "provenanceReport"],
      "properties": {
        "packageInputs": {
          "allOf": [
            { "$ref": "#/$defs/Artifact" },
            {
              "properties": {
                "kind": { "const": "browser_release_package_inputs_check" }
              }
            }
          ]
        },
        "provenanceReport": {
          "allOf": [
            { "$ref": "#/$defs/Artifact" },
            {
              "properties": {
                "kind": { "const": "browser_release_candidate_provenance_report" }
              }
            }
          ]
        }
      }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/Failure" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "pass" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failures": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "fail" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "failures": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "pass" },
          "finalizerStatus": { "const": "pass" }
        },
        "required": ["status", "finalizerStatus"]
      },
      "then": {
        "required": ["outputs", "inputs"]
      }
    }
  ],
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/Hash" },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
