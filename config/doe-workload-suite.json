      "description": "Prove staged Metal buffer writes reach the exact destination bytes before queue completion is reported.",
      "inputs": [
        {
          "kind": "file",
          "path": "runtime/zig/build.zig"
        },
        {
          "kind": "tree",
          "path": "runtime/zig/src/backend/metal"
        },
        {
          "kind": "file",
          "path": "runtime/zig/tests/metal/metal_timing_semantics_test.zig"
        }
      ],
      "oracle": {
        "oracleId": "metal/staged-write-exact-bytes-v1",
        "kind": "process-exit",
        "expectedExitCode": 0
