        "executorId": "zig_runtime_native",
        "executorKind": "native",
        "workingDirectory": "runtime/zig",
        "command": [
          "zig",
          "build",
          "test",
          "-Doptimize=ReleaseFast",
          "-Dtest-filter=metal staged buffer write flush proves exact destination bytes",
          "--summary",
          "all"
        ]
