{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fawn://config/tint-compiler-target-validation.schema.json",
  "title": "Tint compiler target backend validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "evidencePath",
    "evidencePaths",
    "requiredTargets",
    "status",
    "targetCoverage",
    "claimBlockers",
    "claimBlockerSummary",
    "claimBlockerSummaryByEvidencePath",
    "failures",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "tint_compiler_target_validation" },
    "evidencePath": { "type": "string", "minLength": 1 },
    "evidencePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requiredTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/Target" }
    },
    "status": { "enum": ["pass", "fail"] },
    "targetCoverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/TargetCoverage" }
    },
    "claimBlockers": {
      "type": "array",
      "items": { "$ref": "#/$defs/Failure" }
    },
    "claimBlockerSummary": {
      "type": "array",
      "items": { "$ref": "#/$defs/FailureSummary" }
    },
    "claimBlockerSummaryByEvidencePath": {
      "type": "array",
      "items": { "$ref": "#/$defs/EvidencePathFailureSummary" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/Failure" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetCount",
        "coveredTargetCount",
        "rowCount",
        "validatedRows",
        "diagnosticRows",
        "claimBlockerCount",
        "failureCount"
      ],
      "properties": {
        "targetCount": { "type": "integer", "minimum": 0 },
        "coveredTargetCount": { "type": "integer", "minimum": 0 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "validatedRows": { "type": "integer", "minimum": 0 },
        "diagnosticRows": { "type": "integer", "minimum": 0 },
        "claimBlockerCount": { "type": "integer", "minimum": 0 },
        "failureCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "Target": {
      "enum": ["msl", "spirv", "dxil", "hlsl"]
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "FailureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "count"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "EvidencePathFailureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidencePath", "claimBlockerSummary"],
      "properties": {
        "evidencePath": { "type": "string", "minLength": 1 },
        "claimBlockerSummary": {
          "type": "array",
          "items": { "$ref": "#/$defs/FailureSummary" }
        }
      }
    },
    "TargetCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "evidencePaths",
        "rowCount",
        "validatedRows",
        "diagnosticRows",
        "shaderIds"
      ],
      "properties": {
        "target": { "$ref": "#/$defs/Target" },
        "evidencePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rowCount": { "type": "integer", "minimum": 0 },
        "validatedRows": { "type": "integer", "minimum": 0 },
        "diagnosticRows": { "type": "integer", "minimum": 0 },
        "shaderIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
