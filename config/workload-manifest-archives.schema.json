{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doe workload manifest archive registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "archives"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "archives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "originalPath",
          "sha256",
          "archivePath",
          "reason"
        ],
        "properties": {
          "originalPath": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "archivePath": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
