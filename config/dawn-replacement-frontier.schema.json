{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doe://config/dawn-replacement-frontier.schema.json",
  "title": "Dawn replacement frontier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "frontierId",
    "universalClaim",
    "blockerDefinitions",
    "rows"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "dawn_replacement_frontier" },
    "frontierId": { "type": "string", "minLength": 1 },
    "universalClaim": { "$ref": "#/$defs/UniversalClaim" },
    "blockerDefinitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/BlockerDefinition" },
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/FrontierRow" }
    }
  },
  "$defs": {
    "UniversalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "reasonCode"],
      "properties": {
        "allowed": { "type": "boolean" },
        "reasonCode": { "type": "string" }
      }
    },
    "BlockerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "exitCriteria", "evidencePaths"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "exitCriteria": { "type": "string", "minLength": 1 },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "FrontierRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "dawnComparator",
        "doeTarget",
        "currentState",
        "claimAllowed",
        "claimIndexEntryIds",
        "evidencePaths",
        "evidenceSlices",
        "blockers",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "surface": {
          "enum": [
            "native_runtime",
            "package_runtime",
            "browser_runtime",
            "shader_compiler",
            "spec_conformance",
            "drop_in_runtime",
            "evidence_release"
          ]
        },
        "dawnComparator": {
          "enum": [
            "dawn_metal",
            "dawn_vulkan",
            "dawn_d3d12",
            "dawn_node_webgpu",
            "dawn_bun_webgpu",
            "deno_wgpu",
            "chromium_dawn",
            "tint",
            "webgpu_cts",
            "libwebgpu_dawn",
            "dawn_claim_surface"
          ]
        },
        "doeTarget": { "type": "string", "minLength": 1 },
        "currentState": {
          "enum": ["claimable", "covered", "diagnostic", "missing", "unsupported"]
        },
        "claimAllowed": { "type": "boolean" },
        "claimIndexEntryIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidencePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidenceSlices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/EvidenceSlice" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    },
    "EvidenceSlice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "os",
        "arch",
        "gpuApi",
        "gpuVendor",
        "runtimeHost",
        "currentState",
        "claimAllowed",
        "claimIndexEntryIds",
        "evidencePaths",
        "blockers",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": { "type": "string", "minLength": 1 },
        "os": {
          "enum": ["macos", "linux", "windows", "cross-platform"]
        },
        "arch": {
          "enum": ["arm64", "x64", "any"]
        },
        "gpuApi": {
          "enum": [
            "metal",
            "vulkan",
            "d3d12",
            "spirv",
            "wgsl",
            "webgpu",
            "webgpu-cts",
            "none",
            "mixed"
          ]
        },
        "gpuVendor": {
          "enum": ["apple", "amd", "nvidia", "microsoft", "any", "none", "mixed"]
        },
        "runtimeHost": {
          "enum": [
            "native",
            "node",
            "bun",
            "deno",
            "chromium",
            "compiler",
            "cts",
            "drop-in",
            "claim-index"
          ]
        },
        "currentState": {
          "enum": ["claimable", "covered", "diagnostic", "missing", "unsupported"]
        },
        "claimAllowed": { "type": "boolean" },
        "claimIndexEntryIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidencePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "notes": { "type": "string" }
      }
    }
  }
}
